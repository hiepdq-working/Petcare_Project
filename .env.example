# Copy this file to `.env` (same folder) before running `docker compose up`.
# Every value below already has a working default in docker-compose.yml —
# you only need this file to override something (e.g. a real JWT secret
# before exposing this beyond your own machine, or real email/Google
# credentials). Nothing here is required to just try the app locally.

# --- Security ---
# Any long random string. The default in docker-compose.yml is fine for
# local testing but must be changed before deploying anywhere reachable
# by anyone else.
JWT_ACCESS_SECRET=

# --- Optional integrations (safe to leave blank) ---
# Without these, email sending logs to the API container's console instead
# of actually sending, and "Đăng nhập bằng Google" returns a clear error
# instead of working — everything else in the app is unaffected.
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
