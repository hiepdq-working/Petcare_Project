# PostgreSQL connection string. Needs the "cube" and "earthdistance"
# extensions available (Supabase/Neon/local Postgres all support these).
DATABASE_URL="postgresql://user:password@localhost:5432/petcare?schema=public"

PORT=4000
NODE_ENV=development

# Web app origin allowed to call this API (CORS).
WEB_ORIGIN="http://localhost:5173"

# Access token: short-lived JWT, sent in Authorization header.
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"

# Refresh token: opaque random string stored in DB, sent via httpOnly cookie.
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
COOKIE_DOMAIN="localhost"

# Resend (https://resend.com) — used for verification / password-reset emails.
RESEND_API_KEY="re_xxx"
EMAIL_FROM="PetCare <no-reply@yourdomain.com>"

# Google Sign-In (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"

# Base URL of the web app, used to build links inside emails
# (e.g. https://app.petcare.vn/verify-email?token=...).
APP_URL="http://localhost:5173"
