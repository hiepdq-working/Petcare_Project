# PostgreSQL connection string. Needs the "cube" and "earthdistance"
# extensions available (Supabase/Neon/local Postgres all support these).
DATABASE_URL="postgresql://user:password@localhost:5432/petcare?schema=public"

PORT=4000
NODE_ENV=development

# Public origin this API is reachable at — used to build absolute URLs for
# uploaded files (e.g. Pet avatars).
API_PUBLIC_URL="http://localhost:4000"

# Web app origin allowed to call this API (CORS).
WEB_ORIGIN="http://localhost:5173"

# Access token: short-lived JWT, sent in Authorization header.
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"

# Refresh token: opaque random string stored in DB, sent via httpOnly cookie.
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
COOKIE_DOMAIN="localhost"

# SMTP — used for verification / password-reset emails. Works with any
# SMTP provider (Gmail, Outlook, a transactional provider's SMTP endpoint...).
# For Gmail: enable 2-Step Verification on the account, then create an
# "App Password" (myaccount.google.com/apppasswords) — use that as
# SMTP_PASS, never your normal login password. For Outlook/Office365, use
# smtp.office365.com and an App Password the same way if 2FA is enabled.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="you@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
# Gmail/Outlook require the From address to be the authenticated mailbox
# itself (or a verified alias) — you can't spoof an arbitrary address the
# way a custom-domain provider like Resend allows.
EMAIL_FROM="PetCare <you@gmail.com>"

# Google Sign-In (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"

# Base URL of the web app, used to build links inside emails
# (e.g. https://app.petcare.vn/verify-email?token=...).
APP_URL="http://localhost:5173"
