// ============================================================================
// PETCARE V2 — DATABASE SCHEMA
// PostgreSQL + Prisma
//
// See /docs/ARCHITECTURE.md for the reasoning behind every decision below
// (Postgres over MySQL, UUID over autoincrement, PetEvent as the timeline
// spine, AuditLog, geo-search via cube/earthdistance).
// ============================================================================

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [cube, earthdistance]
}

// ----------------------------------------------------------------------------
// IDENTITY DOMAIN
// ----------------------------------------------------------------------------

model User {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String     @db.VarChar(100)
  email     String     @unique @db.VarChar(100)
  phone     String?    @db.VarChar(20)
  // Nullable: a user who signed up via Google has no password until they
  // set one explicitly (Settings > Security).
  password  String?    @db.VarChar(255)
  googleId  String?    @unique @map("google_id") @db.VarChar(100)
  avatar    String?    @db.VarChar(500)
  role      UserRole   @default(PET_OWNER)
  status    UserStatus @default(ACTIVE)

  emailVerifiedAt            DateTime? @map("email_verified_at")
  emailVerificationToken     String?   @unique @map("email_verification_token") @db.VarChar(255)
  emailVerificationExpiresAt DateTime? @map("email_verification_expires_at")

  passwordResetToken     String?   @unique @map("password_reset_token") @db.VarChar(255)
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")

  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  pets          Pet[]
  posts         Post[]
  likes         PostLike[]
  comments      PostComment[]
  reviews       Review[]
  sentMessages  Message[]      @relation("Sender")
  conversationsAsUser1 Conversation[] @relation("User1")
  conversationsAsUser2 Conversation[] @relation("User2")
  notifications Notification[]
  sessions      RefreshToken[]
  auditLogs     AuditLog[]     @relation("AuditActor")
  petEvents     PetEvent[]     @relation("EventActor")
  ownershipFrom PetOwnershipHistory[] @relation("PreviousOwner")
  ownershipTo   PetOwnershipHistory[] @relation("NewOwner")
  ownedHospitals Hospital[]    @relation("HospitalOwner")
  veterinarian  Veterinarian?  @relation("VetAccount")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Random opaque string, not a JWT — see ARCHITECTURE.md / auth module
  // notes on why (server-side revocation without a blacklist).
  token     String   @unique @db.VarChar(500)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model PartnerRegistration {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessType    String   @map("business_type") @db.VarChar(20) // "HOSPITAL" for MVP; "SHOP" reserved for later
  shopName        String   @map("shop_name") @db.VarChar(200)
  ownerName       String   @map("owner_name") @db.VarChar(100)
  phone           String   @db.VarChar(20)
  email           String   @db.VarChar(100)
  address         String   @db.VarChar(300)
  businessLicense String?  @map("business_license") @db.VarChar(500)
  vetCertificate  String?  @map("vet_certificate") @db.VarChar(500)
  status          String   @default("PENDING") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("partner_registrations")
}

// ----------------------------------------------------------------------------
// PET DOMAIN — trung tâm của toàn bộ hệ thống
// ----------------------------------------------------------------------------

model Pet {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String    @db.VarChar(100)
  species   String    @db.VarChar(50)
  breed     String?   @db.VarChar(100)
  birthDate DateTime? @map("birth_date")
  weight    Float?
  avatar    String?   @db.VarChar(500)
  notes     String?   @db.Text
  status    PetStatus @default(ACTIVE)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  vaccinations    Vaccination[]
  medicalRecords  MedicalRecord[]
  appointments    Appointment[]
  events          PetEvent[]
  ownershipHistory PetOwnershipHistory[]

  @@index([ownerId])
  @@map("pets")
}

// Lịch sử đổi chủ — pet có thể được cứu hộ, nhận nuôi, chuyển nhượng.
// Pet.ownerId luôn là chủ HIỆN TẠI; bảng này chỉ để tra cứu lịch sử.
model PetOwnershipHistory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  petId          String   @map("pet_id") @db.Uuid
  pet            Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  previousOwnerId String? @map("previous_owner_id") @db.Uuid
  previousOwner  User?    @relation("PreviousOwner", fields: [previousOwnerId], references: [id])
  newOwnerId     String   @map("new_owner_id") @db.Uuid
  newOwner       User     @relation("NewOwner", fields: [newOwnerId], references: [id])
  reason         String?  @db.VarChar(200)
  transferredAt  DateTime @default(now()) @map("transferred_at")

  @@index([petId])
  @@map("pet_ownership_history")
}

// TRỤC THỜI GIAN CỦA PET — mọi domain publish sự kiện vào đây.
model PetEvent {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  petId         String        @map("pet_id") @db.Uuid
  pet           Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)
  eventType     PetEventType  @map("event_type")
  eventDate     DateTime      @map("event_date")
  referenceType String?       @map("reference_type") @db.VarChar(50)
  referenceId   String?       @map("reference_id") @db.Uuid
  payload       Json?
  createdById   String?       @map("created_by_id") @db.Uuid
  createdBy     User?         @relation("EventActor", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([petId, eventDate])
  @@map("pet_events")
}

enum PetStatus {
  ACTIVE
  DECEASED
  LOST
  TRANSFERRED
}

enum PetEventType {
  MEDICAL
  VACCINATION
  WEIGHT
  APPOINTMENT
  SOCIAL_POST
  SHOP_ORDER
  BIRTHDAY
  ADOPTION
  OWNERSHIP_TRANSFER
  AI_ALERT
  REMINDER
}

// ----------------------------------------------------------------------------
// MEDICAL DOMAIN
// ----------------------------------------------------------------------------

model Vaccination {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  petId       String    @map("pet_id") @db.Uuid
  pet         Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  vaccineName String    @map("vaccine_name") @db.VarChar(200)
  dateGiven   DateTime  @map("date_given")
  nextDueDate DateTime? @map("next_due_date")
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([petId])
  @@map("vaccinations")
}

model MedicalRecord {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  petId            String    @map("pet_id") @db.Uuid
  pet              Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  vetId            String?   @map("vet_id") @db.Uuid
  hospitalId       String?   @map("hospital_id") @db.Uuid
  status           String    @default("NEW") @db.VarChar(20)
  recordDate       DateTime  @default(now()) @map("record_date")
  currentVersionId String?   @unique @map("current_version_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  versions MedicalRecordVersion[] @relation("RecordVersions")
  files    MedicalFile[]

  @@index([petId])
  @@map("medical_records")
}

model MedicalRecordVersion {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordId    String        @map("record_id") @db.Uuid
  record      MedicalRecord @relation("RecordVersions", fields: [recordId], references: [id], onDelete: Cascade)
  versionNo   Int           @map("version_no")
  diagnosis   String?       @db.Text
  treatment   String?       @db.Text
  symptoms    String?       @db.Text
  cause       String?       @db.Text
  conclusion  String?       @db.Text
  notes       String?       @db.Text
  editedById  String        @map("edited_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")

  @@unique([recordId, versionNo])
  @@map("medical_record_versions")
}

model MedicalFile {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordId  String        @map("record_id") @db.Uuid
  record    MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  fileName  String        @map("file_name") @db.VarChar(255)
  fileUrl   String        @map("file_url") @db.VarChar(500)
  fileType  String        @map("file_type") @db.VarChar(50)
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([recordId])
  @@map("medical_files")
}

// ----------------------------------------------------------------------------
// HOSPITAL / VET DOMAIN
// ----------------------------------------------------------------------------

model Hospital {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // The HOSPITAL_OWNER account created after Admin approves this clinic's
  // PartnerRegistration. Everything below this (vets, staff) is managed by
  // that owner, not by Admin.
  ownerId     String?    @map("owner_id") @db.Uuid
  owner       User?      @relation("HospitalOwner", fields: [ownerId], references: [id])
  name        String     @db.VarChar(200)
  description String?    @db.Text
  logo        String?    @db.VarChar(500)
  cover       String?    @db.VarChar(500)
  address     String?    @db.VarChar(300)
  lat         Float?
  lng         Float?
  phone       String?    @db.VarChar(20)
  email       String?    @db.VarChar(100)
  status      ShopStatus @default(PENDING)
  isEmergency Boolean    @default(false) @map("is_emergency")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  services      Service[]
  veterinarians Veterinarian[]

  @@index([lat, lng])
  @@map("hospitals")
}

model Veterinarian {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId    String    @map("hospital_id") @db.Uuid
  hospital      Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  // Every vet logs in themselves in MVP (role VET) — 1:1 with a User.
  userId        String    @unique @map("user_id") @db.Uuid
  user          User      @relation("VetAccount", fields: [userId], references: [id], onDelete: Cascade)
  specialty     String?   @db.VarChar(200)
  experience    Int?
  licenseNumber String?   @map("license_number") @db.VarChar(50)
  status        String    @default("ACTIVE") @db.VarChar(20)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([hospitalId])
  @@map("veterinarians")
}

// ----------------------------------------------------------------------------
// SHOP / SERVICE / APPOINTMENT DOMAIN
// (Shop rows exist so Service/Appointment can reference either provider
// type, but Shop registration/management is NOT built in this MVP.)
// ----------------------------------------------------------------------------

model Shop {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String     @map("owner_id") @db.Uuid
  name        String     @db.VarChar(200)
  description String?    @db.Text
  logo        String?    @db.VarChar(500)
  cover       String?    @db.VarChar(500)
  address     String?    @db.VarChar(300)
  lat         Float?
  lng         Float?
  phone       String?    @db.VarChar(20)
  status      ShopStatus @default(PENDING)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  services Service[]

  @@index([lat, lng])
  @@map("shops")
}

model Service {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerType String    @map("provider_type") @db.VarChar(10) // "SHOP" | "HOSPITAL"
  shopId       String?   @map("shop_id") @db.Uuid
  shop         Shop?     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  hospitalId   String?   @map("hospital_id") @db.Uuid
  hospital     Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  name         String    @db.VarChar(200)
  description  String?   @db.Text
  price        Decimal?  @db.Decimal(10, 2)
  duration     Int?
  createdAt    DateTime  @default(now()) @map("created_at")

  appointments Appointment[]
  images       ServiceImage[]

  @@index([shopId])
  @@index([hospitalId])
  @@map("services")
}

model ServiceImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  imageUrl  String   @map("image_url") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("service_images")
}

model Appointment {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  petId      String            @map("pet_id") @db.Uuid
  pet        Pet               @relation(fields: [petId], references: [id], onDelete: Cascade)
  userId     String            @map("user_id") @db.Uuid
  serviceId  String            @map("service_id") @db.Uuid
  service    Service           @relation(fields: [serviceId], references: [id])
  vetId      String?           @map("vet_id") @db.Uuid
  hospitalId String?           @map("hospital_id") @db.Uuid
  dateTime   DateTime          @map("date_time")
  notes      String?           @db.Text
  status     AppointmentStatus @default(PENDING)
  createdAt  DateTime          @default(now()) @map("created_at")

  history AppointmentHistory[]

  @@index([petId])
  @@index([userId])
  @@map("appointments")
}

model AppointmentHistory {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId String            @map("appointment_id") @db.Uuid
  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  status        AppointmentStatus
  notes         String?           @db.Text
  changedBy     String            @map("changed_by") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([appointmentId])
  @@map("appointment_history")
}

// ----------------------------------------------------------------------------
// COMMUNITY / SOCIAL DOMAIN
// ----------------------------------------------------------------------------

model Post {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  petId     String?  @map("pet_id") @db.Uuid
  content   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  media    PostMedia[]
  likes    PostLike[]
  comments PostComment[]

  @@index([userId])
  @@index([petId])
  @@map("posts")
}

model PostMedia {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String @map("post_id") @db.Uuid
  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaUrl  String @map("media_url") @db.VarChar(500)
  mediaType String @map("media_type") @db.VarChar(10)

  @@map("post_media")
}

model PostLike {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId String @map("post_id") @db.Uuid
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

model PostComment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?  @map("parent_id") @db.Uuid
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([postId])
  @@map("post_comments")
}

model Review {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerType String   @map("provider_type") @db.VarChar(10)
  providerId   String   @map("provider_id") @db.Uuid
  rating       Int      @db.SmallInt
  comment      String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([providerType, providerId])
  @@map("reviews")
}

model Conversation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user1Id   String   @map("user1_id") @db.Uuid
  user1     User     @relation("User1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2Id   String   @map("user2_id") @db.Uuid
  user2     User     @relation("User2", fields: [user2Id], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  messages Message[]

  @@unique([user1Id, user2Id])
  @@map("conversations")
}

model Message {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @map("sender_id") @db.Uuid
  sender         User         @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  message        String       @db.Text
  messageType    String       @default("text") @map("message_type") @db.VarChar(10)
  mediaUrl       String?      @map("media_url") @db.VarChar(500)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("messages")
}

// ----------------------------------------------------------------------------
// NOTIFICATION
// ----------------------------------------------------------------------------

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String           @db.VarChar(200)
  content   String?          @db.Text
  isRead    Boolean          @default(false) @map("is_read")
  refId     String?          @map("ref_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}

// ----------------------------------------------------------------------------
// AUDIT
// ----------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String   @db.VarChar(50)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum UserRole {
  PET_OWNER
  // Clinic manager account — see User.role / Hospital.ownerId comments.
  HOSPITAL_OWNER
  HOSPITAL_STAFF
  VET
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum ShopStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  APPOINTMENT
  MESSAGE
  SOCIAL
  SYSTEM
  PROMOTION
}
