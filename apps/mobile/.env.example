# Copy to `.env` in this folder (apps/mobile). Expo loads it automatically.
#
# Address of the PetCare API as seen FROM THE PHONE. Never "localhost" on a
# real device — use your Mac's LAN IP (run: sh scripts/lan-url.sh). The phone
# must be on the same Wi-Fi. Also set API_PUBLIC_URL to the same host in the
# repo-root .env so uploaded photos load on the phone.
#
# On an Android emulator you can leave this unset and use `adb reverse`.
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000/api
