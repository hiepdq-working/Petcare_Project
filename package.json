{
  "name": "petcare",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev:api": "pnpm --filter @petcare/api dev",
    "dev:web": "pnpm --filter @petcare/web dev",
    "dev:mobile": "pnpm --filter @petcare/mobile start",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @petcare/api prisma:migrate",
    "db:studio": "pnpm --filter @petcare/api prisma:studio"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  }
}
